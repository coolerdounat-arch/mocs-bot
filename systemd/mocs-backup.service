[Unit]
Description=MoCS encrypted user-data backup
After=local-fs.target

[Service]
Type=oneshot
User=discordbot
WorkingDirectory=/opt/discord-bot
Environment=NODE_ENV=production
Environment=PATH=/opt/node-v26.12.1-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node-v26.12.1-linux-x64/bin/node /opt/discord-bot/scripts/backup-offsite.js
UMask=0077
ProtectSystem=strict
ReadWritePaths=/var/lib/mocs-bot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX

# --- Discord ---

DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_OAUTH_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_OAUTH_REDIRECT_URI=https://your-domain.example/portal/auth/discord/callback

# --- Candidate application ---

CANDIDATE_IMAGE_URL=https://i.imgur.com/D1Jfzjx.png
ROBLOX_OAUTH_CLIENT_ID=your_roblox_oauth_client_id
ROBLOX_OAUTH_CLIENT_SECRET=your_roblox_oauth_client_secret
ROBLOX_OAUTH_REDIRECT_URI=https://your-domain.example/roblox/oauth/callback
ROBLOX_OAUTH_PORT=3000
ROBLOX_OAUTH_HOST=127.0.0.1

ALLOWED_GUILD_IDS=

LOADING_EMOJI=
MOCS_CONFIG_FILE=/etc/mocs-bot/config.json
MOCS_SQLITE_FILE=/var/lib/mocs-bot/users.sqlite3

# --- Quota Sheet ---

GOOGLE_API_KEY=your_google_api_key

GOOGLE_APPLICATION_CREDENTIALS=/opt/discord-bot/google-service-account.json
